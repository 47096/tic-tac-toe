{
  "rules": {
    "rooms": {
      "$code": {
        ".read": true,
        ".write": true,
        "board": {
          "$idx": {
            ".validate": "($idx == '0' || $idx == '1' || $idx == '2' || $idx == '3' || $idx == '4' || $idx == '5' || $idx == '6' || $idx == '7' || $idx == '8') && (newData.val() === null || newData.val() === 0 || newData.val() === 1)"
          },
          "$other": {
            ".validate": false
          }
        },
        "turn": {
          ".validate": "newData.val() === 0 || newData.val() === 1"
        },
        "gameOver": {
          ".validate": "newData.isBoolean()"
        },
        "scores": {
          "$idx": {
            ".validate": "($idx == '0' || $idx == '1' || $idx == '2') && newData.isNumber() && newData.val() >= 0"
          },
          "$other": {
            ".validate": false
          }
        },
        "players": {
          "$idx": {
            ".validate": "($idx == '0' || $idx == '1')",
            "emoji": {
              ".validate": "newData.isString() && newData.val().length <= 10"
            },
            "photo": {
              ".validate": "newData.isString() && newData.val().length <= 50000 && newData.val().beginsWith('data:image/')"
            },
            "disconnected": {
              ".validate": "newData.isBoolean()"
            }
          }
        },
        "rematch": {
          "from": {
            ".validate": "newData.val() === 0 || newData.val() === 1"
          },
          "accepted": {
            ".validate": "newData.isBoolean()"
          }
        },
        "status": {
          ".validate": "newData.val() === 'waiting' || newData.val() === 'playing' || newData.val() === 'finished'"
        }
      }
    }
  }
}
